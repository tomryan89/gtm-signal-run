# Copy this file to .env and fill in the values. .env is never committed.

# Claude models (Opus, Fable, Haiku) through the Batch API. console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Companies House public data API (company profiles, officers, owners, filings, documents).
# developer.company-information.service.gov.uk -> register an application -> create a REST API key
COMPANIES_HOUSE_API_KEY=

# FCA Register API (authorised firms, Senior Managers). register.fca.org.uk -> Developer / API access;
# the key is issued to an email address, which goes in FCA_EMAIL
FCA_API_KEY=
FCA_EMAIL=

# Reed job adverts API. reed.co.uk/developers -> sign up for a jobseeker API key
REED_API_KEY=

# Adzuna job adverts API: the "Application ID" and the "Application key". developer.adzuna.com -> register
ADZUNA_APPLICATION_KEY=
ADZUNA_API_KEY=

# ransomware.live Pro API (claimed ransomware victims). ransomware.live -> Pro / API plan. Get written permission
# for your use first; the data is for the key holder's own use, not for republishing
RANSOMWARE_LIVE_API_KEY=

# NewsAPI.ai (Event Registry) news search. newsapi.ai -> sign up -> dashboard -> API key. The free tier only
# covers about the last month
NEWSAPI_KEY=

# Not keys - optional folders
# Where finished spreadsheets are copied for review (leave blank to keep them in the project only)
UPLOADS_DIR=
# The listed-company app ("Principal Risks Scanner", a separate project); default ~/projects/risk-scanner
RISK_SCANNER_DIR=
